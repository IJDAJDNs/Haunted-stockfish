    head.setAttribute('points',
        tipX + ',' + tipY + ' ' +
        (baseX + px * headHalf) + ',' + (baseY + py * headHalf) + ' ' +
        (baseX - px * headHalf) + ',' + (baseY - py * headHalf));
    head.setAttribute('fill', color);
    g.appendChild(head);
    svg.appendChild(g);
